{
  "id": "./",
  "name": "ClimaGrid — Cuaca & Iklim Jawa Timur",
  "short_name": "ClimaGrid",
  "description": "Dashboard cuaca dan iklim terdistribusi untuk Jawa Timur: ringkasan wilayah, peta interpolasi IDW, peringatan dini, dan data 20 stasiun otomatis.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F3F6F5",
  "theme_color": "#0B2530",
  "categories": ["weather", "utilities", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Peta interpolasi",
      "short_name": "Peta",
      "description": "Sebaran suhu, hujan, dan kelembapan Jawa Timur",
      "url": "./index.html#/map",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Peringatan dini",
      "short_name": "Peringatan",
      "description": "Daftar peringatan aktif dan riwayatnya",
      "url": "./index.html#/alerts",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
